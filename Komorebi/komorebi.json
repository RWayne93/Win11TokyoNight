{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "display_index_preferences": {
    "0": "0",
    "1": "HCNRA18317",
    "2": "HCPRA00513"
  },
  "transparency": true,
  "transparency_alpha": 252,
  "default_workspace_padding": 1,
  "default_container_padding": 1,
  "border": true,
  "border_width": 4,
  "border_offset": 0,
  "mouse_follows_focus": true,
  "animation": {
    "enabled": true,
    "duration": 150,
    "fps": 300,
    "style": {
      "movement": "EaseInOutQuad",
      "transparency": "Linear"
    }
  },
  "border_colours": {
    "single": "#e0af68",
    "unfocused": "#9aa5ce",
    "floating": "#e0af68"
  },
  // Every connected monitor needs its own entry in this array. With a single
  // entry, monitors 2 and 3 fall back to a default config that has no work
  // area offset, so YASB's 35px top bar would cover tiled windows there.
  //
  // Workspaces use a single global numbering scheme: the laptop starts with
  // workspace "1", the two externals start with "2" and "3". Pressing a
  // workspace number that does not exist yet creates it on the focused
  // monitor (see scripts/komorebi-workspace.ps1).
  "monitors": [
    // monitor 1, index 0 - laptop panel (BOE0A5C / DISPLAY1)
    {
      "work_area_offset": {
        "left": 0,
        "top": 36,
        "right": 0,
        "bottom": 42
      },
      "workspaces": [
        { "name": "1", "layout": "BSP" }
      ]
    },
    // Windows monitor 2, config index 1 - external (SAM7094 / DISPLAY2)
    {
      "work_area_offset": {
        "left": 0,
        "top": 36,
        "right": 0,
        "bottom": 42
      },
      "workspaces": [
        { "name": "2", "layout": "BSP" }
      ]
    },
    // Windows monitor 3, config index 2 - external (SAM7094 / DISPLAY5)
    {
      "work_area_offset": {
        "left": 0,
        "top": 36,
        "right": 0,
        "bottom": 42
      },
      "workspaces": [
        { "name": "3", "layout": "BSP" }
      ]
    }
  ],
  "manage_rules": [
    {
      "kind": "Class",
      "id": "CabinetWClass",
      "matching_strategy": "Equals"
    }
  ],
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "Photos.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Files.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "SnippingTool.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "ScreenClippingHost.exe",
      "matching_strategy": "Equals"
    }
  ]
}
