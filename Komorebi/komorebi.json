{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "transparency": true,
  "transparency_alpha": 252,
  "default_workspace_padding": 1,
  "default_container_padding": 1,
  "border": true,
  "border_width": 4,
  "border_offset": 0,
  "mouse_follows_focus": false,
  "animation": {
    "enabled": true,
    "duration": 150,
    "fps": 300,
    "style": {
      "movement": "EaseInOutQuad",
      "transparency": "Linear"
    }
  },
  "border_colours": {
    "single": "#e0af68",
    "unfocused": "#9aa5ce",
    "floating": "#e0af68"
  },
  "monitors": [
    {
      "work_area_offset": {
        "left": 0,
        "top": 36,
        "right": 0,
        "bottom": 42
      },
      "workspaces": [
        { "name": "1", "layout": "BSP" },
        { "name": "2", "layout": "Grid" },
        { "name": "3", "layout": "HorizontalStack" },
        { "name": "4", "layout": "BSP" },
        { "name": "5", "layout": "BSP" },
        { "name": "6", "layout": "BSP" },
        { "name": "7", "layout": "BSP" },
        { "name": "8", "layout": "BSP" },
        { "name": "9", "layout": "BSP" },
        { "name": "10", "layout": "BSP" }
      ]
    }
  ],
  "manage_rules": [
    {
      "kind": "Class",
      "id": "CabinetWClass",
      "matching_strategy": "Equals"
    }
  ],
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "Photos.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Files.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "SnippingTool.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "ScreenClippingHost.exe",
      "matching_strategy": "Equals"
    }
  ]
}
