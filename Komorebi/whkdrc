
.shell powershell

# ==========================================
# HyDE-inspired Windows keybindings
# SUPER = Windows key
# ==========================================

# Applications
win + t : start wt.exe
win + e : start explorer.exe
win + b : start firefox.exe
win + c : start code.exe
win + shift + p : start ms-screenclip:

# Window management
win + q : komorebic close
win + w : komorebic toggle-float
win + j : komorebic flip-layout horizontal

# Directional focus
win + left  : komorebic focus left
win + right : komorebic focus right
win + up    : komorebic focus up
win + down  : komorebic focus down

# Move windows in the layout
win + ctrl + shift + left  : komorebic move left
win + ctrl + shift + right : komorebic move right
win + ctrl + shift + up    : komorebic move up
win + ctrl + shift + down  : komorebic move down

# Resize focused window
win + shift + left  : komorebic resize-axis horizontal decrease
win + shift + right : komorebic resize-axis horizontal increase
win + shift + up    : komorebic resize-axis vertical increase
win + shift + down  : komorebic resize-axis vertical decrease

# ==========================================
# Workspaces (global numbering across monitors)
#
# Workspace numbers are global: 1 lives on the laptop, 2 and 3 on the two
# external monitors, and any number that does not exist yet is created on
# whichever monitor has focus when you press it.
# ==========================================

win + 1 : & "$HOME\.config\komorebi-workspace.ps1" -Number 1 -Mode focus
win + 2 : & "$HOME\.config\komorebi-workspace.ps1" -Number 2 -Mode focus
win + 3 : & "$HOME\.config\komorebi-workspace.ps1" -Number 3 -Mode focus
win + 4 : & "$HOME\.config\komorebi-workspace.ps1" -Number 4 -Mode focus
win + 5 : & "$HOME\.config\komorebi-workspace.ps1" -Number 5 -Mode focus
win + 6 : & "$HOME\.config\komorebi-workspace.ps1" -Number 6 -Mode focus
win + 7 : & "$HOME\.config\komorebi-workspace.ps1" -Number 7 -Mode focus
win + 8 : & "$HOME\.config\komorebi-workspace.ps1" -Number 8 -Mode focus
win + 9 : & "$HOME\.config\komorebi-workspace.ps1" -Number 9 -Mode focus
win + 0 : & "$HOME\.config\komorebi-workspace.ps1" -Number 10 -Mode focus

# Move window and follow it
win + shift + 1 : & "$HOME\.config\komorebi-workspace.ps1" -Number 1 -Mode move
win + shift + 2 : & "$HOME\.config\komorebi-workspace.ps1" -Number 2 -Mode move
win + shift + 3 : & "$HOME\.config\komorebi-workspace.ps1" -Number 3 -Mode move
win + shift + 4 : & "$HOME\.config\komorebi-workspace.ps1" -Number 4 -Mode move
win + shift + 5 : & "$HOME\.config\komorebi-workspace.ps1" -Number 5 -Mode move
win + shift + 6 : & "$HOME\.config\komorebi-workspace.ps1" -Number 6 -Mode move
win + shift + 7 : & "$HOME\.config\komorebi-workspace.ps1" -Number 7 -Mode move
win + shift + 8 : & "$HOME\.config\komorebi-workspace.ps1" -Number 8 -Mode move
win + shift + 9 : & "$HOME\.config\komorebi-workspace.ps1" -Number 9 -Mode move
win + shift + 0 : & "$HOME\.config\komorebi-workspace.ps1" -Number 10 -Mode move

# Move window without following it
win + alt + 1 : & "$HOME\.config\komorebi-workspace.ps1" -Number 1 -Mode send
win + alt + 2 : & "$HOME\.config\komorebi-workspace.ps1" -Number 2 -Mode send
win + alt + 3 : & "$HOME\.config\komorebi-workspace.ps1" -Number 3 -Mode send
win + alt + 4 : & "$HOME\.config\komorebi-workspace.ps1" -Number 4 -Mode send
win + alt + 5 : & "$HOME\.config\komorebi-workspace.ps1" -Number 5 -Mode send
win + alt + 6 : & "$HOME\.config\komorebi-workspace.ps1" -Number 6 -Mode send
win + alt + 7 : & "$HOME\.config\komorebi-workspace.ps1" -Number 7 -Mode send
win + alt + 8 : & "$HOME\.config\komorebi-workspace.ps1" -Number 8 -Mode send
win + alt + 9 : & "$HOME\.config\komorebi-workspace.ps1" -Number 9 -Mode send
win + alt + 0 : & "$HOME\.config\komorebi-workspace.ps1" -Number 10 -Mode send

# Relative workspace navigation
win + ctrl + right : komorebic cycle-workspace next
win + ctrl + left  : komorebic cycle-workspace previous

# ==========================================
# Monitors
# ==========================================

# Focus the next/previous monitor in the cycle
win + alt + right : komorebic cycle-monitor next
win + alt + left  : komorebic cycle-monitor previous

# Move the focused window to the next/previous monitor
win + ctrl + alt + right : komorebic cycle-move-to-monitor next
win + ctrl + alt + left  : komorebic cycle-move-to-monitor previous

# Maintenance
win + shift + r : komorebic retile
win + alt + r : komorebic reload-configuration


# ========================================
# HyDE-style window grouping / stacking
# ========================================

# Group windows
win + shift + g : komorebic stack-all

# Navigate within group
win + alt + h : komorebic cycle-stack previous
win + alt + l : komorebic cycle-stack next

# Remove focused window from stack
win + shift + u : komorebic unstack
